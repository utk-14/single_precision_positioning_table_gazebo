<?xml version="1.0"?>
<robot name="precision_positioning_table" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find precision_positioning_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find precision_positioning_description)/urdf/ros2_control.xacro" />

  <!-- World link -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- Base Link (Aluminium Base Plate) -->
  <link name="base_link">
    <visual>
      <origin xyz="0.100 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.250 0.120 0.020"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="0.100 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.250 0.120 0.020"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.100 0 -0.01" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.00185" ixy="0" ixz="0" iyy="0.00786" iyz="0" izz="0.00966"/>
    </inertial>
  </link>

  <!-- NEMA17 Stepper Motor Body -->
  <link name="nema17_motor">
    <visual>
      <origin xyz="-0.021 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <box size="0.042 0.042 0.042"/>
      </geometry>
      <material name="stepper_blue"/>
    </visual>
    <collision>
      <origin xyz="-0.021 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <box size="0.042 0.042 0.042"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.021 0 0" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="motor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="nema17_motor"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
  </joint>

  <!-- Flexible Shaft Coupling -->
  <link name="shaft_coupling">
    <visual>
      <origin xyz="0.010 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.020"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="0.010 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.020"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.010 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="coupling_joint" type="fixed">
    <parent link="nema17_motor"/>
    <child link="shaft_coupling"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- KP08 Bearing Block (Motor End) -->
  <link name="kp08_bearing_front">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.055 0.029"/>
      </geometry>
      <material name="steel"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.055 0.029"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="kp08_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="kp08_bearing_front"/>
    <origin xyz="0.022 0 0.0145" rpy="0 0 0"/>
  </joint>

  <!-- KP08 Bearing Block (Far End) -->
  <link name="kp08_bearing_rear">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.055 0.029"/>
      </geometry>
      <material name="steel"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.055 0.029"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="kp08_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="kp08_bearing_rear"/>
    <origin xyz="0.210 0 0.0145" rpy="0 0 0"/>
  </joint>

  <!-- Two Linear Guide Rods -->
  <link name="guide_rod_1">
    <visual>
      <origin xyz="0.100 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.200"/>
      </geometry>
      <material name="steel"/>
    </visual>
    <collision>
      <origin xyz="0.100 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.200"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="guide_rod_1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="guide_rod_1"/>
    <origin xyz="0.010 0.035 0.025" rpy="0 0 0"/>
  </joint>

  <link name="guide_rod_2">
    <visual>
      <origin xyz="0.100 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.200"/>
      </geometry>
      <material name="steel"/>
    </visual>
    <collision>
      <origin xyz="0.100 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.200"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="guide_rod_2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="guide_rod_2"/>
    <origin xyz="0.010 -0.035 0.025" rpy="0 0 0"/>
  </joint>

  <!-- Rotary Encoder -->
  <link name="rotary_encoder">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.020"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.020"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/>
    </inertial>
  </link>

  <joint name="encoder_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rotary_encoder"/>
    <origin xyz="0.222 0 0.025" rpy="0 0 0"/>
  </joint>

  <!-- Lead Screw Link (Rotates) -->
  <link name="lead_screw">
    <visual>
      <origin xyz="0.100 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.200"/>
      </geometry>
      <material name="brass"/>
    </visual>
    <!-- Visual marker stripe on lead screw to clearly show visual rotation -->
    <visual>
      <origin xyz="0.100 0.003 0" rpy="0 1.570796 0"/>
      <geometry>
        <box size="0.001 0.002 0.198"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0.100 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.200"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.100 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <!-- Motor to Lead Screw Revolute Joint -->
  <joint name="lead_screw_joint" type="revolute">
    <parent link="nema17_motor"/>
    <child link="lead_screw"/>
    <origin xyz="0.010 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1000.0" upper="1000.0" effort="2.0" velocity="100.0"/>
    <dynamics damping="0.01" friction="0.02"/>
  </joint>

  <!-- Moving Platform (Translates along X only) -->
  <link name="platform">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.080 0.020"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <!-- Brass Lead Nut indicator -->
    <visual>
      <origin xyz="0 0 -0.008" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.007" length="0.016"/>
      </geometry>
      <material name="brass"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.080 0.020"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.00014" ixy="0" ixz="0" iyy="0.000027" iyz="0" izz="0.00015"/>
    </inertial>
  </link>

  <!-- Add this block directly below </link> for Gazebo rendering -->
  <gazebo reference="platform">
    <visual>
      <material>
        <ambient>1.0 0.4 0.7 1.0</ambient>
        <diffuse>1.0 0.4 0.7 1.0</diffuse>
      </material>
    </visual>
  </gazebo>

  <!-- Base to Platform Prismatic Joint (Travel 0.0 to 0.18079 m) -->
  <joint name="platform_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="platform"/>
    <origin xyz="0.025 0 0.033" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.18079" effort="50.0" velocity="0.1"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- Gazebo ros2_control plugin setup -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find precision_positioning_control)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="nema17_motor">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="lead_screw">
    <material>Gazebo/Gold</material>
  </gazebo>
  <gazebo reference="platform">
    <material>Gazebo/Grey</material>
  </gazebo>
</robot>
