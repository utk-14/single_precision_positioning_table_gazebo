<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>precision_positioning_control</name>
  <version>1.0.0</version>
  <description>ROS 2 control nodes, PID controller, and encoder simulator for Precision Positioning Table</description>
  <maintainer email="engineer@robotics.org">ROS2 Engineer</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>controller_manager</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>joint_trajectory_controller</depend>
  <depend>position_controllers</depend>
  <depend>precision_positioning_interfaces</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
